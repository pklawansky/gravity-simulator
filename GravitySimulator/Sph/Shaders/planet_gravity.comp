// Planet formation's Barnes-Hut gravity (G = 1): the same stackless walk of the flattened octree as
// gravity.comp, with the CPU tree's physics (BarnesHutTree.AccelerationAt): one Plummer softening
// eps^2 for every pair and node, a node is used whole when size^2 < theta^2 d^2 and the point is
// outside its cube. A leaf at zero distance (the particle itself) is skipped. Thread k handles
// pos[k] (the CPU orders the particles in tree-walk order so neighbouring threads walk alike).
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer Pos { vec4 pos[]; };
layout(std430, binding = 1) writeonly buffer AccOut { vec4 accOut[]; };
layout(std430, binding = 2) readonly buffer NodeA { vec4 comMass[]; };
layout(std430, binding = 3) readonly buffer NodeB { vec4 centreHalf[]; };
layout(std430, binding = 4) readonly buffer NodeC { vec4 links[]; };     // skip (int bits), body (int bits), soft^2
uniform uint uNodeCount;
uniform float uTheta2;
uniform float uEps2;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uCount) return;
    vec3 p = pos[i].xyz;
    vec3 acc = vec3(0.0);
    uint n = 0u;
    while (n < uNodeCount)
    {
        vec4 cm = comMass[n];
        vec4 lk = links[n];
        uint skip = uint(floatBitsToInt(lk.x));
        int body = floatBitsToInt(lk.y);
        vec3 d = cm.xyz - p;
        float d2 = dot(d, d);
        if (body >= 0)
        {
            if (d2 > 0.0 && cm.w > 0.0)
            {
                float inv = 1.0 / sqrt(d2 + uEps2);
                acc += d * (cm.w * inv * inv * inv);
            }
            n = skip;
            continue;
        }
        vec4 ch = centreHalf[n];
        float size = 2.0 * ch.w;
        bool inside = all(lessThanEqual(abs(p - ch.xyz), vec3(ch.w)));
        if (size * size < uTheta2 * d2 && !inside)
        {
            float inv = 1.0 / sqrt(d2 + uEps2);
            acc += d * (cm.w * inv * inv * inv);
            n = skip;
        }
        else n++;
    }
    accOut[i] = vec4(acc, 0.0);
}
