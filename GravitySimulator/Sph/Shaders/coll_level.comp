// Collision broad phase on the GPU (uniform grid per size level, after Green 2010 "Particle Simulation using
// CUDA"; the levels mirror CollisionResolver's hierarchical hash), step 1: each live body's level, the lowest
// whose cell (uC0 x 2^level) is at least 2.002 x its radius, and per level the count and largest radius.
// info: [0, 48) counts, [48, 96) largest radius (float bits; positive floats order as uints), [96, 144) list
// starts, [144, 192) list fills, [192] top level.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Body { vec4 body[]; };   // key order: xyz, mass
layout(std430, binding = 1) readonly buffer Rad { float rad[]; };
layout(std430, binding = 2) writeonly buffer Lvl { uint lvl[]; };
layout(std430, binding = 3) buffer Info { uint info[]; };
uniform float uC0;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uCount) return;
    float r = rad[i];
    if (!(body[i].w > 0.0)) { lvl[i] = 0xFFFFFFFFu; return; }
    float d = 2.002 * r, c = uC0;
    uint l = 0u;
    while (c < d && l < 47u) { c *= 2.0; l++; }
    lvl[i] = l;
    atomicAdd(info[l], 1u);
    atomicMax(info[48u + l], floatBitsToUint(r));
    atomicMax(info[192], l);
}
