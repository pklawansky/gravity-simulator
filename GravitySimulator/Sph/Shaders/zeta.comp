// Adaptive-softening correction (Price & Monaghan 2007): a_i -= sum m_j [xi_i gradW(h_i) + xi_j gradW(h_j)].
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer PosH { vec4 posH[]; };
layout(std430, binding = 1) readonly buffer MassId { vec4 massId[]; };
layout(std430, binding = 2) readonly buffer Start { uint cellStart[]; };
layout(std430, binding = 3) readonly buffer Xi { float xi[]; };
layout(std430, binding = 4) buffer AccOut { vec4 accOut[]; };
layout(std430, binding = 5) readonly buffer Ctrl { uint ctrl[]; };
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uCount) return;
    if (massId[i].x <= 0.0) return;
    float cell = max(2.0 * uintBitsToFloat(ctrl[0]), 1e-30);
    vec4 pI = posH[i];
    vec3 x = pI.xyz;
    float hi = pI.w, xii = xi[i];
    vec3 a = vec3(0.0);
    ivec3 cc = cellOf(x, cell);
    for (int dz = -1; dz <= 1; dz++)
    for (int dy = -1; dy <= 1; dy++)
    for (int dx = -1; dx <= 1; dx++)
    {
        ivec3 c = cc + ivec3(dx, dy, dz);
        uint b = hashCell(c);
        uint e = cellStart[b + 1u];
        for (uint j = cellStart[b]; j < e; j++)
        {
            if (j == i) continue;
            vec4 pj = posH[j];
            if (cellOf(pj.xyz, cell) != c) continue;
            vec3 xij = x - pj.xyz;
            float r2 = dot(xij, xij);
            float hj = pj.w;
            float hmax = max(hi, hj);
            if (r2 >= 4.0 * hmax * hmax) continue;
            float r = sqrt(r2);
            a -= massId[j].x * (xii * gradW(xij, r, hi) + xi[j] * gradW(xij, r, hj));
        }
    }
    accOut[i].xyz += a;
}
