// Barnes-Hut self-gravity: stackless walk of the flattened octree (first child = n + 1, skip = node
// after the subtree), Plummer softening eps^2 = (h_i^2 + h_node^2)/2. Writes the potential and the
// adaptive-softening coefficient xi = -h^2 S / (6 rho). Mirrors FlatTree.Acceleration.
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer PosH { vec4 posH[]; };
layout(std430, binding = 1) readonly buffer RhoP { vec4 rhoP[]; };
layout(std430, binding = 2) buffer AccOut { vec4 accOut[]; };
layout(std430, binding = 3) buffer Extra { vec4 extra[]; };
layout(std430, binding = 4) writeonly buffer Xi { float xiOut[]; };
layout(std430, binding = 5) readonly buffer NodeA { vec4 comMass[]; };
layout(std430, binding = 6) readonly buffer NodeB { vec4 centreHalf[]; };
layout(std430, binding = 7) readonly buffer NodeC { vec4 links[]; };     // skip (int bits), body (int bits), soft^2
uniform uint uNodeCount;
uniform float uTheta2;
uniform float uHMin, uHMax;
// Paczynski-Wiita black holes (not in the tree): xyz + mass, and r_s. Mirrors SphReference.PaczynskiWiitaAcceleration.
uniform int uPwCount;
uniform vec4 uPw[8];
uniform float uPwRs[8];
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uCount) return;
    vec4 pI = posH[i];
    vec3 p = pI.xyz;
    float h = pI.w, h2 = h * h;
    vec3 acc = vec3(0.0);
    float phi = 0.0, sum = 0.0;
    uint n = 0u;
    while (n < uNodeCount)
    {
        vec4 cm = comMass[n];
        vec4 lk = links[n];
        uint skip = uint(floatBitsToInt(lk.x));
        int body = floatBitsToInt(lk.y);
        vec3 d = cm.xyz - p;
        float d2 = dot(d, d);
        if (body >= 0)
        {
            if (d2 > 0.0 && cm.w > 0.0)
            {
                float inv = 1.0 / sqrt(d2 + 0.5 * (h2 + lk.z));
                float mi3 = cm.w * inv * inv * inv;
                acc += d * mi3;
                sum += mi3;
                phi -= cm.w * inv;
            }
            n = skip;
            continue;
        }
        vec4 ch = centreHalf[n];
        float size = 2.0 * ch.w;
        bool inside = all(lessThanEqual(abs(p - ch.xyz), vec3(ch.w)));
        if (size * size < uTheta2 * d2 && !inside)
        {
            float inv = 1.0 / sqrt(d2 + 0.5 * (h2 + lk.z));
            float mi3 = cm.w * inv * inv * inv;
            acc += d * mi3;
            sum += mi3;
            phi -= cm.w * inv;
            n = skip;
        }
        else n++;
    }
    for (int k = 0; k < uPwCount; k++)
    {
        vec3 d = uPw[k].xyz - p;
        float r = length(d);
        if (!(r > 0.0)) continue;
        float x = max(r - uPwRs[k], 1e-3 * uPwRs[k]);
        acc += d * (uPw[k].w / (x * x * r));
        phi -= uPw[k].w / x;
    }
    accOut[i].xyz += acc;
    extra[i].w = phi;
    xiOut[i] = (h <= uHMin || h >= uHMax) ? 0.0 : -h2 * sum / (6.0 * rhoP[i].x);
}
