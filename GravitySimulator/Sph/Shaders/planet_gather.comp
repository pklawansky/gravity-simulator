// GPU octree build: bodies into key order (dst[k] = src[order[k]]), and their radii when uWithRadius != 0
// (the collision broad phase reads them in the same order).
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Order { uint order[]; };
layout(std430, binding = 1) readonly buffer Src { vec4 src[]; };
layout(std430, binding = 2) writeonly buffer Dst { vec4 dst[]; };
layout(std430, binding = 3) readonly buffer SrcR { float srcR[]; };
layout(std430, binding = 4) writeonly buffer DstR { float dstR[]; };
uniform uint uWithRadius;
void main()
{
    uint k = gl_GlobalInvocationID.x;
    if (k >= uCount) return;
    uint o = order[k];
    dst[k] = src[o];
    if (uWithRadius != 0u) dstR[k] = srcR[o];
}
