// Sink accretion (Bate, Bonnell & Price 1995). Sinks [0, uExisting) accrete bound gas inside their
// accretion radius (most bound wins); sinks [uExisting, uSinkCount) are forming and gather all gas
// inside uSinkRadius (nearest wins, before any existing sink). An absorbed particle is appended to
// the event list and gets mass 0. Mirrors SphReference.FindAccretions.
layout(local_size_x = 128) in;
struct Sink { vec4 posR; vec4 velM; };          // xyz, accretion radius; xyz velocity, mass
struct Event { vec4 posM; vec4 velS; };         // xyz, mass; xyz velocity, sink index (int bits)
layout(std430, binding = 0) readonly buffer PosH { vec4 posH[]; };
layout(std430, binding = 1) readonly buffer Vel { vec4 vel[]; };
layout(std430, binding = 2) buffer MassId { vec4 massId[]; };
layout(std430, binding = 3) readonly buffer Sinks { Sink sinks[]; };
layout(std430, binding = 4) writeonly buffer Events { Event events[]; };
layout(std430, binding = 5) buffer Ctrl { uint ctrl[]; };
uniform uint uExisting, uSinkCount, uEventCapacity;
uniform float uSinkRadius;
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uCount) return;
    float mi = massId[i].x;
    if (mi <= 0.0) return;
    vec3 xi = posH[i].xyz, vi = vel[i].xyz;
    int best = -1;
    float bestD2 = uSinkRadius * uSinkRadius;
    for (uint k = uExisting; k < uSinkCount; k++)
    {
        vec3 d = sinks[k].posR.xyz - xi;
        float d2 = dot(d, d);
        if (d2 < bestD2) { bestD2 = d2; best = int(k); }
    }
    if (best < 0)
    {
        float bestE = 0.0;
        for (uint k = 0u; k < uExisting; k++)
        {
            Sink s = sinks[k];
            float ms = s.velM.w;
            if (ms <= 0.0) continue;
            vec3 d = s.posR.xyz - xi;
            float d2 = dot(d, d);
            if (d2 >= s.posR.w * s.posR.w) continue;
            vec3 dv = s.velM.xyz - vi;
            float e = 0.5 * dot(dv, dv) - (ms + mi) / max(sqrt(d2), 1e-12);
            if (s.posR.w < 0.0) e = -3.0e38;          // absorbing inner boundary (Paczynski-Wiita hole)
            if (e < bestE) { bestE = e; best = int(k); }
        }
    }
    if (best < 0) return;
    uint slot = atomicAdd(ctrl[3], 1u);
    if (slot >= uEventCapacity) return;           // list full: this particle waits for the next step
    events[slot].posM = vec4(xi, mi);
    events[slot].velS = vec4(vi, intBitsToFloat(best));
    massId[i].x = 0.0;
}
