// Collision broad phase, step 2 (one thread): where each level's body list starts (levels in order).
layout(local_size_x = 1) in;
layout(std430, binding = 0) buffer Info { uint info[]; };
void main()
{
    uint run = 0u;
    for (uint l = 0u; l <= info[192]; l++)
    {
        info[96u + l] = run;
        run += info[l];
    }
}
