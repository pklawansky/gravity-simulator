// Counting sort, step 1: bucket (hashed cell of size 2 h_max) per particle and its rank in it.
layout(local_size_x = 128) in;
layout(std430, binding = 0) readonly buffer PosH { vec4 posH[]; };
layout(std430, binding = 1) readonly buffer MassId { vec4 massId[]; };
layout(std430, binding = 2) writeonly buffer Key { uint key[]; };
layout(std430, binding = 3) writeonly buffer Rank { uint rank[]; };
layout(std430, binding = 4) buffer Count { uint cellCount[]; };
layout(std430, binding = 5) readonly buffer Ctrl { uint ctrl[]; };
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uCount) return;
    float cell = max(2.0 * uintBitsToFloat(ctrl[0]), 1e-30);
    uint k = massId[i].x > 0.0 ? hashCell(cellOf(posH[i].xyz, cell)) : uTableSize;
    key[i] = k;
    rank[i] = atomicAdd(cellCount[k], 1u);
}
