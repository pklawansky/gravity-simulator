// Opening half-kick and drift of the leapfrog, then h from the previous step's density.
// Also reduces h_max (cell size of this step's grid = 2 h_max).
layout(local_size_x = 128) in;
layout(std430, binding = 0) buffer PosH { vec4 posH[]; };
layout(std430, binding = 1) buffer Vel { vec4 vel[]; };          // xyz v, w u
layout(std430, binding = 2) readonly buffer Acc { vec4 acc[]; }; // xyz a, w du/dt
layout(std430, binding = 3) readonly buffer MassId { vec4 massId[]; };
layout(std430, binding = 4) readonly buffer RhoP { vec4 rhoP[]; };
layout(std430, binding = 5) buffer Ctrl { uint ctrl[]; };
uniform float uDt;
uniform int uKick;       // 1: half-kick + drift
uniform int uUpdateH;    // 1: h = eta (m/rho)^(1/3)
uniform int uIdeal;
uniform float uUMin, uEta, uHMin, uHMax;
uniform float uCoolBeta, uCoolFloor; // radiative cooling (0 = off), see coolU
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uCount) return;
    float m = massId[i].x;
    if (m <= 0.0) return;
    vec4 p = posH[i];
    if (uKick == 1)
    {
        vec4 v = vel[i];
        vec4 a = acc[i];
        float hdt = 0.5 * uDt;
        v.xyz += a.xyz * hdt;
        if (uIdeal == 1) v.w = coolU(max(v.w + a.w * hdt, uUMin), rhoP[i].x, hdt, uCoolBeta, uCoolFloor);
        p.xyz += v.xyz * uDt;
        vel[i] = v;
    }
    if (uUpdateH == 1)
        p.w = clamp(uEta * pow(m / max(rhoP[i].x, 1e-30), 1.0 / 3.0), uHMin, uHMax);
    posH[i] = p;
    atomicMax(ctrl[0], floatBitsToUint(p.w));
}
