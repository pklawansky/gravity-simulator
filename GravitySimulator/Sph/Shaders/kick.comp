// Closing half-kick, then the particle time step reduced to a global minimum:
// dt = C h / (c + 1.2 (alpha c + beta mu_max)), and dt <= C sqrt(h / |a|).
layout(local_size_x = 128) in;
layout(std430, binding = 0) buffer Vel { vec4 vel[]; };
layout(std430, binding = 1) readonly buffer AccOut { vec4 acc[]; };
layout(std430, binding = 2) readonly buffer PosH { vec4 posH[]; };
layout(std430, binding = 3) readonly buffer RhoP { vec4 rhoP[]; };
layout(std430, binding = 4) readonly buffer Extra { vec4 extra[]; };
layout(std430, binding = 5) buffer Ctrl { uint ctrl[]; };
layout(std430, binding = 6) readonly buffer MassId { vec4 massId[]; };
uniform float uDt;
uniform int uKick, uIdeal;
uniform float uUMin, uCourant, uAlpha, uBeta;
uniform float uCoolBeta, uCoolFloor; // radiative cooling (0 = off), see coolU
uniform float uDamping;   // velocity factor per step (1 = none; < 1 only for relaxation)
void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uCount) return;
    if (massId[i].x <= 0.0) return;
    vec4 a = acc[i];
    if (uKick == 1)
    {
        vec4 v = vel[i];
        float hdt = 0.5 * uDt;
        v.xyz += a.xyz * hdt;
        if (uIdeal == 1) v.w = coolU(max(v.w + a.w * hdt, uUMin), rhoP[i].x, hdt, uCoolBeta, uCoolFloor);
        v.xyz *= uDamping;
        vel[i] = v;
    }
    float h = posH[i].w, cs = rhoP[i].z, muMax = extra[i].z;
    float signal = cs + 1.2 * (uAlpha * cs + uBeta * muMax);
    float dt = signal > 0.0 ? uCourant * h / signal : 3.0e38;
    float am = length(a.xyz);
    if (am > 0.0) dt = min(dt, uCourant * sqrt(h / am));
    atomicMin(ctrl[1], floatBitsToUint(dt));
}
