// GPU octree build, step 5: writes every node at its pre-order index base[first] + level - lmin[first]
// (base = exclusive scan of the per-body node counts) in the stackless layout planet_gravity.comp walks:
// an internal node's first child is the next node, and skip = the first node of the next body range,
// base[end] (base[n] = node count).
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer NInfo { uvec4 nInfo[]; };
layout(std430, binding = 1) readonly buffer NGeom { vec4 nGeom[]; };
layout(std430, binding = 2) readonly buffer NMom { vec4 nMom[]; };
layout(std430, binding = 3) readonly buffer Base { uint base[]; };
layout(std430, binding = 4) readonly buffer LMin { uint lmin[]; };
struct Node { vec4 comMass; vec4 centreHalf; uvec4 link; };   // link = (skip, first body, bodies, leaf)
layout(std430, binding = 5) writeonly buffer Nodes { Node nodes[]; };
layout(std430, binding = 6) readonly buffer Ctrl { uint ctrl[]; };
uniform uint uNodeCap;
void main()
{
    uint nd = gl_GlobalInvocationID.x;
    if (nd >= min(ctrl[0], uNodeCap)) return;
    uvec4 info = nInfo[nd];
    if (info.x > uCount || info.y > uCount) return; // never after a complete build; guards an overflowed one
    uint level = info.z >> 4;
    uint pre = base[info.x] + level - lmin[info.x];
    if (pre >= uNodeCap) return;
    Node o;
    o.comMass = nMom[nd];
    o.centreHalf = nGeom[nd];
    o.link = uvec4(base[info.y], info.x, info.y - info.x, (info.z & 15u) == 0u ? 1u : 0u);
    nodes[pre] = o;
}
